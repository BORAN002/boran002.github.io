1:["$","$Ld",null,{"active":"/notes/","aside":[["$","div",null,{"className":"aside-block","children":[["$","p",null,{"className":"aside-label","children":"THE NOTEBOOK"}],["$","h2",null,{"children":"两种记录方式"}],["$","a",null,{"className":"aside-index-link","href":"/blog/","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":16}],"Blog"]}],["$","p",null,{"children":"把一个问题展开，写成一篇完整的文章。"}],["$","a",null,{"className":"aside-index-link","href":"/notes/","children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z","key":"1oefj6"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"M10 9H8","key":"b1mrlr"}],["path",{"d":"M16 13H8","key":"t4e002"}],["path",{"d":"M16 17H8","key":"z1uh3a"}]],"className":"lucide-file-text","size":16}],"Notes"]}],["$","p",null,{"children":"留住片段、疑问和实践中的一点发现。"}]]}],["$","div",null,{"className":"aside-block","children":[["$","h2",null,{"children":"保持连接"}],["$","p",null,{"children":"通过 RSS 订阅，新文章会出现在你的阅读器里。"}],["$","a",null,{"className":"text-link","href":"/feed.xml","children":["订阅更新 ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":13}]]}]]}]],"children":[["$","div",null,{"className":"page-top","children":[["$","span",null,{"children":[["$","a",null,{"href":"/","children":"Riven's notebook"}],["$","span",null,{"className":"breadcrumb-separator","children":"/"}],"笔记"]}],["$","span",null,{"className":"top-note","children":"一点一滴，积累成篇"}]]}],["$","header",null,{"className":"page-heading","children":[["$","span",null,{"className":"eyebrow","children":"SMALL STEPS, EVERY DAY"}],["$","h1",null,{"children":["Notes",["$","span",null,{"children":"学习笔记"}]]}],["$","p",null,{"children":["读到的、试过的、想明白的。",["$","br",null,{}],"记录过程，也留下一些尚未解决的问题。"]}]]}],["$","$Lf",null,{"kind":"notes","entries":[]}]],"entries":[{"slug":"hello-world","kind":"blog","title":"从这里开始","description":"给博客和笔记留一个位置，也给尚未想明白的问题留一点空间。","date":"2026-10-20","updated":"2026-10-20","tags":["小站日常"],"url":"/blog/hello-world/","minutes":1,"text":"给这个小站一个新的开始。\n\n这里会慢慢放下学习中的理解、实践中的记录，以及暂时还没有答案的问题。长一点的内容写成博客，零散的想法留在笔记里。\n\n 博客与笔记\n\nBlog 用来放整理过的文章。围绕一个问题，把背景、思路和结论讲清楚。\n\nNotes 用来保存学习过程。一段代码、一次实验、读论文时的疑问，都可以成为一条笔记。内容不必一次写完，有新的理解就继续补充。\n\n 留下可以回看的线索\n\n记录的时候，尽量带上原始资料和必要的上下文。哪些已经验证，哪些仍是猜想，也分开写清楚。\n\n希望过一段时间再回来，仍然能看懂当时为什么这样想。\n\n 慢慢来\n\n小站会随着内容一起生长。\n\n把日子，骑慢一点。把想法，写下来。"}]}]
